# このファイルを`.env`へコピーし、環境ごとの値を設定してください。
#
# Rails自身がプロジェクトルートの`.env`を直接読み込むわけではありません。
# `docker-compose.yml`の`backend.env_file: .env`により、Docker Composeが
# `.env`の値をbackendコンテナの環境変数として渡し、Railsが`ENV`から参照します。
# 値を変更した場合は、次のコマンドでbackendコンテナを再作成してください。
# docker compose up -d --force-recreate backend

# Docker Compose
USERNAME=app
PASSWORD=app
DATABASE=app_development

# Devise JWT署名鍵（`docker compose run --rm backend bin/rails secret`で生成）
DEVISE_JWT_SECRET_KEY=

# Google Maps Embed API専用キー
GOOGLE_MAPS_EMBED_API_KEY=
