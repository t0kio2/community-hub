<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : "運営管理画面" %> | Community Hub</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
  </head>
  <body class="admin-page">
    <%
      page_heading = if controller_path == "admin/home"
        "ダッシュボード"
      elsif controller_path == "admin/tenant_accounts"
        {
          "index" => "テナントアカウント",
          "show" => "テナント詳細",
          "new" => "テナント作成",
          "create" => "テナント作成",
          "edit" => "テナント編集",
          "update" => "テナント編集"
        }.fetch(action_name, "テナント管理")
      else
        "運営管理"
      end
    %>

    <div class="admin-shell">
      <aside class="admin-sidebar">
        <%= link_to admin_root_path, class: "admin-brand", aria: { label: "Community Hub 運営管理" } do %>
          <span class="admin-brand-mark">C</span>
          <span><strong>Community Hub</strong><small>Operations admin</small></span>
        <% end %>

        <div class="environment-label"><span></span>運営管理画面</div>

        <nav class="admin-navigation" aria-label="運営管理">
          <p>OVERVIEW</p>
          <%= link_to admin_root_path, class: [current_page?(admin_root_path) && "active"] do %>
            <span>⌂</span>ダッシュボード
          <% end %>

          <p>PLATFORM</p>
          <%= link_to admin_tenant_accounts_path, class: [(controller_path == "admin/tenant_accounts" && !%w[new create].include?(action_name)) && "active"] do %>
            <span>▣</span>テナント管理
          <% end %>
          <%= link_to new_admin_tenant_account_path, class: [(controller_path == "admin/tenant_accounts" && %w[new create].include?(action_name)) && "active"] do %>
            <span>＋</span>テナント作成
          <% end %>
        </nav>

        <div class="admin-sidebar-footer">
          <div class="admin-account">
            <span class="admin-avatar"><%= current_admin.role == "super_admin" ? "SA" : "OP" %></span>
            <span class="admin-account-copy">
              <strong><span class="visually-hidden">ログイン中:</span><%= current_admin_account.email %></strong>
              <small><span class="visually-hidden">ロール:</span><%= current_admin.role %>・<%= current_admin.status %></small>
            </span>
          </div>
          <%= button_to "ログアウト", destroy_admin_account_session_path, method: :post, class: "logout-button" %>
        </div>
      </aside>

      <main class="admin-main">
        <header class="admin-topbar">
          <div>
            <p class="admin-breadcrumb">ADMIN / COMMUNITY HUB</p>
            <h1><%= page_heading %></h1>
          </div>
          <div class="admin-top-actions">
            <span class="system-health"><i></i>運営管理者としてログイン中</span>
          </div>
        </header>

        <div class="admin-content">
          <% if flash[:notice] %>
            <div class="flash notice" role="status"><%= flash[:notice] %></div>
          <% end %>
          <% if flash[:alert] %>
            <div class="flash alert" role="alert"><%= flash[:alert] %></div>
          <% end %>

          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
