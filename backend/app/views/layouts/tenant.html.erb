<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : "テナント管理画面" %> | Community Hub</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tenant", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "confirmation_modal", "data-turbo-track": "reload" %>
    <%= yield :stylesheets if content_for?(:stylesheets) %>
  </head>
  <body class="tenant-page">
    <%
      signed_in = defined?(tenant_account_signed_in?) && tenant_account_signed_in?
      tenant_member = signed_in ? current_tenant_account&.tenant_member : nil
      tenant_organization = tenant_member&.tenant
      listing_section_active = controller_path == "tenant/listings"
      organization_section_active = controller_path == "tenant/organizations"
      location_section_active = controller_path == "tenant/locations"
      requested_listing_type = params[:listing_type].presence || params.dig(:listing, :listing_type)
    %>

    <div class="tenant-shell">
      <aside class="tenant-sidebar">
        <%= link_to tenant_root_path, class: "tenant-brand", aria: { label: "Community Hub テナント管理画面" } do %>
          <span class="tenant-brand-mark">C</span>
          <span>
            <strong>Community Hub</strong>
            <small>Tenant workspace</small>
          </span>
        <% end %>

        <% if signed_in %>
          <nav class="tenant-navigation" aria-label="テナント管理">
            <%= link_to tenant_root_path, class: ["tenant-home-link", current_page?(tenant_root_path) && "active"] do %>
              <span class="tenant-nav-icon">⌂</span>ホーム
            <% end %>

            <section class="tenant-menu-section <%= "has-active" if listing_section_active %>">
              <div class="tenant-menu-heading">
                <span aria-hidden="true">◇</span>
                <div>
                  <strong>掲載管理</strong>
                  <small>宿泊と求人の管理</small>
                </div>
              </div>
              <div class="tenant-menu-items">
                <%= link_to tenant_listings_path, class: [(listing_section_active && !%w[new create].include?(action_name)) && "active"] do %>
                  掲載一覧
                <% end %>
                <%= link_to new_tenant_listing_path(listing_type: "job"), class: [(listing_section_active && %w[new create].include?(action_name) && requested_listing_type == "job") && "active"] do %>
                  求人を作成
                <% end %>
                <%= link_to new_tenant_listing_path(listing_type: "stay"), class: [(listing_section_active && %w[new create].include?(action_name) && requested_listing_type == "stay") && "active"] do %>
                  宿泊を作成
                <% end %>
              </div>
            </section>

            <% if tenant_member&.role == "owner" && tenant_organization.present? %>
              <section class="tenant-menu-section <%= "has-active" if organization_section_active || location_section_active %>">
                <div class="tenant-menu-heading">
                  <span aria-hidden="true">◉</span>
                  <div>
                    <strong>組織設定</strong>
                    <small>基本情報の管理</small>
                  </div>
                </div>
                <div class="tenant-menu-items">
                  <%= link_to "組織情報", edit_tenant_organization_path, class: [organization_section_active && "active"] %>
                  <%= link_to "拠点管理", tenant_locations_path, class: [location_section_active && "active"] %>
                </div>
              </section>
            <% end %>
          </nav>
        <% else %>
          <div class="tenant-session-context">
            <span></span>
            テナント管理画面
          </div>
        <% end %>

        <div class="tenant-sidebar-footer">
          <% if signed_in %>
            <div class="tenant-account">
              <span class="tenant-account-avatar"><%= tenant_member&.role == "owner" ? "O" : "S" %></span>
              <span class="tenant-account-copy">
                <strong><%= tenant_organization&.name.presence || "テナント未設定" %></strong>
                <small><span class="visually-hidden">ロール:</span><%= tenant_member&.role.presence || "ロール未設定" %>・<%= tenant_member&.status.presence || "状態未設定" %></small>
                <small class="tenant-account-email"><%= current_tenant_account.email %></small>
              </span>
            </div>
            <%= button_to "ログアウト", destroy_tenant_account_session_path, method: :post, class: "tenant-logout-button" %>
          <% else %>
            <%= link_to "ログイン", new_tenant_account_session_path, class: "tenant-login-link" %>
          <% end %>
        </div>
      </aside>

      <main class="tenant-main">
        <header class="tenant-topbar">
          <div>
            <% if content_for?(:back_link) %>
              <%= yield :back_link %>
            <% else %>
              <p class="tenant-breadcrumb">
                TENANT<% if tenant_organization&.name.present? %> / <%= tenant_organization.name %><% end %>
              </p>
            <% end %>
            <h1 id="tenant-page-title">
              <% if content_for?(:page_title) %>
                <%= yield :page_title %>
              <% elsif content_for?(:title) %>
                <%= yield :title %>
              <% else %>
                テナントホーム
              <% end %>
            </h1>
          </div>
          <% if signed_in %>
            <div class="tenant-top-actions">
              <span class="tenant-session-state"><i></i>テナントとしてログイン中</span>
            </div>
          <% end %>
        </header>

        <div class="tenant-content">
          <% if flash[:notice] %>
            <div class="tenant-flash notice" role="status"><%= flash[:notice] %></div>
          <% end %>
          <% if flash[:alert] %>
            <div class="tenant-flash alert" role="alert"><%= flash[:alert] %></div>
          <% end %>

          <%= yield %>
        </div>
      </main>
    </div>
    <%= render "shared/confirmation_modal" %>
  </body>
</html>
