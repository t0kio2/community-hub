<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "tenant/stay_dashboard", "data-turbo-track": "reload" %>
<% end %>

<% content_for :tenant_sidebar_brand do %>
  <%= link_to tenant_stay_path(@listing), class: "tenant-brand tenant-brand--facility", aria: { label: "#{@listing.title} 宿泊施設管理" } do %>
    <span class="tenant-brand-mark tenant-brand-mark--facility" aria-hidden="true">
      <%= render "shared/icon", name: "stays" %>
    </span>
    <span class="tenant-brand-copy">
      <small>Community Hub</small>
      <strong><%= @listing.title %></strong>
      <span>宿泊施設管理</span>
    </span>
  <% end %>
<% end %>

<% content_for :tenant_sidebar_navigation do %>
  <%
    facility_information_active = controller_path == "tenant/stays" && action_name.in?(%w[show edit update])
    room_types_active = controller_path == "tenant/stay_management/room_types"
    rooms_active = controller_path.in?([
      "tenant/stay_management/rooms",
      "tenant/stay_management/room_blocks",
      "tenant/stay_management/bed_blocks",
      "tenant/stay_management/inventory_blocks"
    ])
    rate_plans_active = controller_path == "tenant/stay_management/rate_plans"
    sales_calendar_active = controller_path == "tenant/stay_management/sales_calendars"
  %>
  <nav class="tenant-navigation stay-facility-navigation" aria-label="<%= @listing.title %>の宿泊施設管理">
    <%= link_to tenant_stays_path, class: "stay-facility-navigation__back" do %>
      <span aria-hidden="true">←</span>
      宿泊施設一覧へ戻る
    <% end %>

    <div class="stay-facility-navigation__divider"></div>

    <p class="stay-facility-navigation__section-label">運営</p>

    <span class="stay-facility-navigation__item stay-facility-navigation__item--disabled" aria-disabled="true">
      <span class="stay-facility-navigation__icon" aria-hidden="true">≡</span>
      <span><strong>予約管理</strong><small>予約の検索と確認</small></span>
      <em>準備中</em>
    </span>

    <p class="stay-facility-navigation__section-label">施設管理</p>

    <%= link_to tenant_stay_path(@listing),
                class: ["stay-facility-navigation__item", facility_information_active && "active"],
                aria: (facility_information_active ? { current: "page" } : {}) do %>
      <span class="stay-facility-navigation__icon" aria-hidden="true">⚙</span>
      <span><strong>施設情報</strong><small>基本情報・宿泊・予約設定</small></span>
    <% end %>

    <%= link_to tenant_stay_room_types_path(@listing),
                class: ["stay-facility-navigation__item", room_types_active && "active"],
                aria: (room_types_active ? { current: "page" } : {}) do %>
      <span class="stay-facility-navigation__icon" aria-hidden="true">▤</span>
      <span><strong>客室タイプ</strong><small>販売する客室分類</small></span>
    <% end %>

    <%= link_to tenant_stay_rooms_path(@listing),
                class: ["stay-facility-navigation__item", rooms_active && "active"],
                aria: (rooms_active ? { current: "page" } : {}) do %>
      <span class="stay-facility-navigation__icon" aria-hidden="true">▤</span>
      <span><strong>割り当て客室管理</strong><small>物理客室と販売在庫</small></span>
    <% end %>

    <%= link_to tenant_stay_rate_plans_path(@listing),
                class: ["stay-facility-navigation__item", rate_plans_active && "active"],
                aria: (rate_plans_active ? { current: "page" } : {}) do %>
      <span class="stay-facility-navigation__icon" aria-hidden="true">¥</span>
      <span><strong>料金プラン</strong><small>販売条件と基本料金</small></span>
    <% end %>

    <%= link_to tenant_stay_sales_calendar_path(@listing),
                class: ["stay-facility-navigation__item", sales_calendar_active && "active"],
                aria: (sales_calendar_active ? { current: "page" } : {}) do %>
      <span class="stay-facility-navigation__icon" aria-hidden="true">▥</span>
      <span><strong>販売カレンダー</strong><small>日別料金と販売上限</small></span>
    <% end %>


    <!-- TODO: ActiveDecoratorを導入しそこに定義する -->
    <% [
      ["公開設定", "公開条件と受付状態", "✓"]
    ].each do |label, description, icon| %>
      <span class="stay-facility-navigation__item stay-facility-navigation__item--disabled" aria-disabled="true">
        <span class="stay-facility-navigation__icon" aria-hidden="true"><%= icon %></span>
        <span><strong><%= label %></strong><small><%= description %></small></span>
        <em>準備中</em>
      </span>
    <% end %>
  </nav>
<% end %>

<% content_for :back_link do %>
  <p class="tenant-breadcrumb">STAY / <%= @listing.title %></p>
<% end %>

<%= render template: "layouts/tenant" %>
