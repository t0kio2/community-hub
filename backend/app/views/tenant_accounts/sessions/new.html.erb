<header class="authentication-card__header">
  <p>TENANT SIGN IN</p>
  <h2>テナントログイン</h2>
  <span>登録されたテナントアカウントでログインしてください。</span>
</header>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "authentication-form" }) do |f| %>
  <div class="authentication-field">
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email, id: "tenant_email", required: true, autofocus: true, autocomplete: "username", placeholder: "name@example.com" %>
  </div>

  <div class="authentication-field">
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password, id: "tenant_password", required: true, autocomplete: "current-password", placeholder: "パスワードを入力" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <label class="authentication-remember">
      <%= f.check_box :remember_me %>
      <span>ログイン状態を保持する</span>
    </label>
  <% end %>

  <%= f.submit "ログイン", class: "authentication-submit" %>
<% end %>

<p class="authentication-support">ログインできない場合は、組織の管理者へお問い合わせください。</p>
