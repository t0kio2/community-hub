<div class="listing-form-page">
  <%= render "tenant/shared/forms/errors", records: [listing, stay_listing] %>

  <%= form_with model: listing, url: form_url, local: true, class: "listing-form" do |form| %>
    <section class="form-section" aria-labelledby="stay-basic-heading">
      <%= render "tenant/shared/forms/section_heading",
                 id: "stay-basic-heading",
                 title: "施設の基本情報",
                 description: "最初に施設の骨格だけを登録します。客室や料金は登録後に設定します。" %>

      <div class="field field-wide">
        <label>種別</label>
        <strong>宿泊施設</strong>
        <%= form.hidden_field :listing_type %>
      </div>

      <div class="field field-wide">
        <%= form.label :title do %>
          施設名<span class="required-badge">必須</span>
        <% end %>
        <%= form.text_field :title, placeholder: "山のホテル", required: true %>
      </div>

      <%= form.hidden_field :status, value: "draft" unless listing.persisted? %>

      <div class="field field-wide">
        <%= form.label :description do %>
          施設紹介<span class="required-badge required-badge--publish">公開時必須</span>
        <% end %>
        <%= form.text_area :description, rows: 5, placeholder: "施設の特徴や周辺環境を入力してください" %>
      </div>

      <div class="field field-wide stay-registration-location">
        <%= form.label :tenant_location_id do %>
          所在地<span class="required-badge required-badge--publish">公開時必須</span>
        <% end %>
        <% locations = @tenant&.tenant_locations&.order(:name, :id) || [] %>
        <% if locations.any? %>
          <%= form.select :tenant_location_id,
                          locations.map { |location| ["#{location.name}｜#{location.full_address.presence || "住所未設定"}", location.id] },
                          { include_blank: "拠点を選択してください" } %>
          <p>登録済みの拠点を施設所在地として使用します。<%= link_to "拠点を管理", tenant_locations_path %></p>
        <% else %>
          <div class="stay-registration-location__empty">
            <strong>所在地となる拠点が登録されていません</strong>
            <p>宿泊施設を登録する前に、住所と緯度・経度を持つ拠点を登録してください。</p>
            <%= link_to "拠点を登録", new_tenant_location_path, class: "tenant-listing-button tenant-listing-button--primary" %>
          </div>
        <% end %>
      </div>
    </section>

    <%= fields_for "listing[stay_listing]", stay_listing do |detail_form| %>
      <section class="form-section" aria-labelledby="stay-times-heading">
        <%= render "tenant/shared/forms/section_heading",
                   id: "stay-times-heading",
                   title: "宿泊時刻",
                   description: "利用者へ案内するチェックイン・チェックアウト時刻を設定します。" %>

        <div class="field">
          <%= detail_form.label :check_in_time do %>
            チェックイン開始時刻<span class="required-badge required-badge--publish">公開時必須</span>
          <% end %>
          <div class="stay-native-picker stay-time-picker">
            <%= detail_form.time_field :check_in_time, class: "stay-native-picker-field" %>
            <span class="stay-picker-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></svg>
            </span>
          </div>
        </div>
        <div class="field">
          <%= detail_form.label :latest_check_in_time do %>
            最終チェックイン時刻<span class="required-badge required-badge--publish">公開時必須</span>
          <% end %>
          <div class="stay-native-picker stay-time-picker">
            <%= detail_form.time_field :latest_check_in_time, class: "stay-native-picker-field" %>
            <span class="stay-picker-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></svg>
            </span>
          </div>
          <small class="listing-form-field-hint">チェックイン開始時刻より後の時刻を設定してください。</small>
        </div>
        <div class="field">
          <%= detail_form.label :check_out_time do %>
            チェックアウト時刻<span class="required-badge required-badge--publish">公開時必須</span>
          <% end %>
          <div class="stay-native-picker stay-time-picker">
            <%= detail_form.time_field :check_out_time, class: "stay-native-picker-field" %>
            <span class="stay-picker-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></svg>
            </span>
          </div>
        </div>
        <div class="field">
          <span class="listing-form-field-label">タイムゾーン</span>
          <div class="stay-fixed-value">日本時間（Asia/Tokyo）</div>
          <%= detail_form.hidden_field :time_zone, value: "Asia/Tokyo" %>
          <small class="listing-form-field-hint">初期仕様では日本時間に固定されます。</small>
        </div>
      </section>

      <section class="form-section" aria-labelledby="stay-booking-heading">
        <%= render "tenant/shared/forms/section_heading",
                   id: "stay-booking-heading",
                   title: "予約受付",
                   description: "予約の確定方法と、予約を受け付ける期間を設定します。" %>

        <div class="field">
          <%= detail_form.label :booking_confirmation_mode, "予約確定方式" %>
          <%= detail_form.select :booking_confirmation_mode,
                                 [["承認制", "approval_required"], ["即時予約", "instant"]] %>
        </div>
        <div class="field">
          <%= detail_form.label :approval_deadline_hours, "承認期限" %>
          <%= detail_form.number_field :approval_deadline_hours, min: 1, max: 72, step: 1 %>
          <small class="listing-form-field-hint">予約申請から承認までの期限を時間単位で設定します。</small>
        </div>
        <div class="field">
          <%= detail_form.label :booking_open_days_before, "予約受付開始" %>
          <%= detail_form.number_field :booking_open_days_before, min: 1, max: 365, step: 1 %>
          <small class="listing-form-field-hint">チェックイン日の何日前から受け付けるかを設定します。</small>
        </div>
        <div class="field">
          <%= detail_form.label :booking_close_hours_before, "予約受付終了" %>
          <%= detail_form.number_field :booking_close_hours_before, min: 0, max: 720, step: 1 %>
          <small class="listing-form-field-hint">チェックインの何時間前に締め切るかを設定します。</small>
        </div>
        <div class="field">
          <%= detail_form.label :stay_available_starts_on, "宿泊可能期間の開始日" %>
          <div class="stay-native-picker stay-date-picker">
            <%= detail_form.date_field :stay_available_starts_on, class: "stay-native-picker-field" %>
            <span class="stay-picker-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="4" y="5.5" width="16" height="14" rx="2"></rect><path d="M8 3.5v4M16 3.5v4M4 9.5h16"></path></svg>
            </span>
          </div>
        </div>
        <div class="field">
          <%= detail_form.label :stay_available_ends_on, "宿泊可能期間の終了日" %>
          <div class="stay-native-picker stay-date-picker">
            <%= detail_form.date_field :stay_available_ends_on, class: "stay-native-picker-field" %>
            <span class="stay-picker-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="4" y="5.5" width="16" height="14" rx="2"></rect><path d="M8 3.5v4M16 3.5v4M4 9.5h16"></path></svg>
            </span>
          </div>
          <small class="listing-form-field-hint">この日はチェックアウト日として扱い、宿泊日は前日までです。</small>
        </div>
        <div class="field field-wide">
          <%= detail_form.label :house_rules, "ハウスルール" %>
          <%= detail_form.text_area :house_rules, rows: 5, placeholder: "館内禁煙、消灯時間など、宿泊者へ案内するルールを入力してください" %>
        </div>
      </section>
    <% end %>

    <%= render "tenant/shared/forms/actions",
               form: form,
               submit_label: listing.persisted? ? "更新する" : "施設を登録して設定へ進む" %>
  <% end %>
</div>
