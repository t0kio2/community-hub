<% content_for :title, "割当て客室管理" %>
<% content_for :page_title, "割当て客室管理" %>

<section class="stay-dashboard" aria-labelledby="tenant-page-title">
  <section class="stay-dashboard__card">
    <div class="stay-dashboard__card-heading">
      <div>
        <h2>割当て客室一覧</h2>
        <p><%= @rooms.size %>件の客室が登録されています</p>
      </div>
      <%= link_to "客室を登録",
                  new_tenant_stay_room_path(@listing),
                  class: "stay-dashboard__button stay-dashboard__button--primary" %>
    </div>

    <% if @rooms.any? %>
      <div class="data-table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">名称</th>
              <th scope="col">状態</th>
							<th scope="col">メモ</th>
              <th scope="col"><span class="visually-hidden">操作</span></th>
            </tr>
          </thead>
          <tbody>
            <% @rooms.each do |room| %>
              <tr>
                <td>
                  <strong class="data-table__primary"><%= room.name %></strong>
                </td>
                <td>
                  <span class="stay-status stay-status--<%= room.active %>">
                    <%= room.active? ? "有効" : "無効" %>
                  </span>
                </td>
								<td>
									<%= room.note %>
								</td>
                <td>
                  <div class="table-actions">
                    <%= link_to "編集",
                                edit_tenant_stay_room_path(@listing, room),
                                class: "table-action table-action--secondary" %>
                    <%= button_to "削除",
                                tenant_stay_room_path(@listing, room),
                                method: :delete,
                                class: "table-action table-action--danger",
                                form: {
                                  data: {
                                    confirm_message: "#{room.name}を削除します。この操作は取り消せません。"
                                  }
                                } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= link_to new_tenant_stay_room_path(@listing), class: "text-decoration-none" do %>
        <div class="stay-dashboard__empty-state">
          <span aria-hidden="true">＋</span>
          <div>
            <strong>客室がまだ登録されていません</strong>
            <p>客室タイプに割り当てるお部屋・ベッドを登録してください。</p>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>
</section>
