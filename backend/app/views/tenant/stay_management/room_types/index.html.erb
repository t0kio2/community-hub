<% content_for :title, "客室タイプ管理" %>
<% content_for :page_title, "客室タイプ" %>

<% room_kind_labels = {
  "entire_place" => "一棟貸し",
  "private_room" => "個室",
  "shared_room" => "相部屋"
} %>
<% status_labels = {
  "published" => "公開中",
  "draft" => "下書き",
  "inactive" => "停止中"
} %>

<section class="stay-dashboard stay-room-types" aria-labelledby="tenant-page-title">
  <section class="stay-dashboard__card">
    <div class="stay-dashboard__card-heading">
      <div>
        <h2>客室タイプ一覧</h2>
        <p><%= @room_types.size %>件の客室タイプが登録されています</p>
      </div>
      <%= link_to "客室タイプを登録",
                  new_tenant_stay_room_type_path(@listing),
                  class: "stay-dashboard__button stay-dashboard__button--primary" %>
    </div>

    <% if @room_types.any? %>
      <div class="data-table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">名称</th>
              <th scope="col">利用形態</th>
              <th scope="col">定員</th>
              <th scope="col">割当て客室</th>
              <th scope="col">状態</th>
              <th scope="col"><span class="visually-hidden">操作</span></th>
            </tr>
          </thead>
          <tbody>
            <% @room_types.each do |room_type| %>
              <tr>
                <td>
                  <strong class="data-table__primary"><%= room_type.name %></strong>
                  <% if room_type.description.present? %>
                    <small class="data-table__secondary">
                      <%= truncate(room_type.description, length: 80) %>
                    </small>
                  <% end %>
                </td>
                <td>
                  <%= room_kind_labels.fetch(room_type.room_kind, room_type.room_kind) %>
                </td>
                <td>
                  <%= room_type.capacity.present? ? "#{room_type.capacity}名" : "未設定" %>
                </td>
                <td>
                  <span class="data-table__inline-detail">
                    <span class="data-table__primary">
                      <%= room_type.stay_rooms.size %>室
                    </span>
                    <span class="data-table__secondary">
                      <%= room_type.stay_rooms.any? ? "客室を見る" : "客室を割当てる" %>
                    </span>
                  </span>
                </td>
                <td>
                  <span class="stay-status stay-status--<%= room_type.status %>">
                    <%= status_labels.fetch(room_type.status, room_type.status) %>
                  </span>
                </td>
                <td>
                  <div class="table-actions">
                    <%= link_to "編集",
                                edit_tenant_stay_room_type_path(@listing, room_type),
                                class: "table-action table-action--secondary" %>
                    <%= button_to "削除",
                                tenant_stay_room_type_path(@listing, room_type),
                                method: :delete,
                                class: "table-action table-action--danger",
                                form: {
                                  data: {
                                    confirm_message: "#{room_type.name}を削除します。この操作は取り消せません。"
                                  }
                                } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= link_to new_tenant_stay_room_type_path(@listing), class: "text-decoration-none" do %>
        <div class="stay-dashboard__empty-state">
          <span aria-hidden="true">＋</span>
          <div>
            <strong>客室タイプがまだ登録されていません</strong>
            <p>シングル、ダブル、女性専用ドミトリーなど、宿泊者が選ぶ客室分類を登録してください。</p>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>
</section>
