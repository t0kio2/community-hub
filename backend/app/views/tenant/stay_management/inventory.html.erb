<% content_for :title, "Room／Bed管理" %><% content_for :page_title, "Room／Bed管理" %>
<% content_for :stylesheets do %><%= stylesheet_link_tag "tenant/stay_management", "data-turbo-track": "reload" %><% end %>
<% content_for :back_link do %><a href="#" class="tenant-back-link">← 山のホテルの概要へ戻る</a><% end %>

<% rooms = [{ name: "101号室", type: "個室ツイン", active: true }, { name: "102号室", type: "個室ツイン", active: true }, { name: "ドミトリーA", type: "男女共用ドミトリー・6 Beds", active: true }, { name: "旧館201", type: "未分類・販売対象外", active: false }] %>

<section class="stay-management" aria-labelledby="tenant-page-title">
  <%= render "prototype_notice" %><%= render "facility_navigation", active: :inventory %>
  <header class="stay-management-page-lead"><div><p class="stay-management-eyebrow">PHYSICAL INVENTORY</p><h2>施設内の物理在庫</h2><p>実在するRoomと相部屋のBedを台帳として管理します。</p></div><button type="button" class="stay-management-button stay-management-button--primary">＋ Roomを登録</button></header>

  <div class="stay-management-master-detail stay-management-master-detail--inventory">
    <aside class="stay-management-card stay-entity-panel"><div class="stay-management-card-heading"><div><h3>全Room</h3><p>4件・未分類 1件</p></div></div><div class="stay-entity-list"><% rooms.each_with_index do |room, index| %><button type="button" class="stay-entity-row <%= "selected" if index == 2 %>"><span><strong><%= room[:name] %></strong><small><%= room[:type] %></small></span><span class="stay-status <%= room[:active] ? "stay-status--published" : "stay-status--inactive" %>"><%= room[:active] ? "有効" : "停止" %></span></button><% end %></div></aside>

    <div class="stay-management-stack">
      <form action="#" class="stay-management-card stay-editor-card">
        <div class="stay-management-card-heading"><div><h3>ドミトリーA</h3><p>男女共用ドミトリー</p></div><label class="stay-switch"><input type="checkbox" checked><span></span><em>有効</em></label></div>
        <div class="stay-management-fields"><label><span>管理名</span><input value="ドミトリーA"></label><label><span>所属Room Type</span><select><option>男女共用ドミトリー</option><option>未分類</option></select></label><label class="wide"><span>管理メモ</span><textarea rows="3">本館2階。入口右側。</textarea></label></div>
        <div class="stay-management-actions"><button type="button" class="stay-management-button stay-management-button--primary">更新する</button></div>
      </form>

      <section class="stay-management-card"><div class="stay-management-card-heading"><div><h3>Bed構成</h3><p>相部屋として販売する物理Bed</p></div><button type="button" class="stay-management-button">＋ Bedを追加</button></div><div class="stay-bed-list"><% 6.times do |index| %><div><span class="stay-bed-icon">B</span><input value="A-<%= index + 1 %>"><span class="stay-status stay-status--published">有効</span><button type="button" class="stay-text-action">停止期間</button></div><% end %></div></section>
      <section class="stay-management-card"><div class="stay-management-card-heading"><div><h3>Room停止期間</h3><p>清掃、メンテナンスなどの一時停止</p></div><button type="button" class="stay-management-button">＋ 停止期間を追加</button></div><div class="stay-empty-state">停止期間はありません</div></section>
    </div>
  </div>
</section>
