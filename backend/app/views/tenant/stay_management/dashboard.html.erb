<% content_for :title, "山のホテル - 宿泊管理" %>
<% content_for :page_title, "山のホテル" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "tenant/stay_management", "data-turbo-track": "reload" %>
<% end %>
<% content_for :back_link do %>
  <a href="#" class="tenant-back-link">← 宿泊施設へ戻る</a>
<% end %>

<%
  room_types = [
    { name: "個室ツイン", unit: "個室", inventory: 5, plans: 2, status: "公開中" },
    { name: "男女共用ドミトリー", unit: "Bed", inventory: 6, plans: 1, status: "公開中" },
    { name: "離れ一棟", unit: "一棟", inventory: 1, plans: 1, status: "下書き" }
  ]
%>

<section class="stay-management" aria-labelledby="tenant-page-title">
  <%= render "prototype_notice" %>
  <%= render "facility_navigation", active: :dashboard %>

  <header class="stay-management-page-lead">
    <div><p class="stay-management-eyebrow">FACILITY OVERVIEW</p><h2>施設ダッシュボード</h2><p>販売開始までの準備状況と施設構成を確認します。</p></div>
    <span class="stay-status stay-status--published">公開中</span>
  </header>

  <div class="stay-management-metrics">
    <article><span>Room Types</span><strong>3</strong><small>2件 公開中</small></article>
    <article><span>物理在庫</span><strong>12</strong><small>Room / Bedの有効数</small></article>
    <article><span>Rate Plans</span><strong>2</strong><small>4件の料金設定</small></article>
    <article><span>承認待ち</span><strong>4</strong><small>予約機能接続後に表示</small></article>
  </div>

  <div class="stay-management-dashboard-grid">
    <section class="stay-management-card stay-management-card--table">
      <div class="stay-management-card-heading"><div><h3>販売構成</h3><p>Room Typeごとの在庫と料金</p></div><a href="#">編集する</a></div>
      <div class="stay-management-table-wrap"><table class="stay-management-table"><thead><tr><th>Room Type</th><th>販売単位</th><th>物理在庫</th><th>料金プラン</th><th>状態</th></tr></thead><tbody>
        <% room_types.each do |room_type| %><tr><td><strong><%= room_type[:name] %></strong></td><td><%= room_type[:unit] %></td><td><%= room_type[:inventory] %></td><td><%= room_type[:plans] %></td><td><span class="stay-status <%= room_type[:status] == "公開中" ? "stay-status--published" : "stay-status--draft" %>"><%= room_type[:status] %></span></td></tr><% end %>
      </tbody></table></div>
    </section>

    <aside class="stay-management-card stay-publication-card">
      <div class="stay-management-card-heading"><div><h3>公開準備</h3><p>6 / 7 項目が完了</p></div><strong>86%</strong></div>
      <div class="stay-readiness"><div><i style="width: 86%"></i></div></div>
      <ul class="stay-check-list">
        <li class="done"><span>✓</span>施設情報</li><li class="done"><span>✓</span>拠点</li><li class="done"><span>✓</span>Room Type</li><li class="done"><span>✓</span>物理在庫</li><li class="done"><span>✓</span>料金プラン</li><li><span>!</span>施設画像を追加</li>
      </ul>
      <a href="#" class="stay-management-button stay-management-button--primary stay-management-button--wide">不足項目を確認</a>
    </aside>
  </div>
</section>
