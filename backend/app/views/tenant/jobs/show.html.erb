<% content_for :title, @listing.title %>
<% content_for :page_title, "求人詳細" %>
<% content_for :stylesheets do %><%= stylesheet_link_tag "tenant/listings", "data-turbo-track": "reload" %><% end %>
<% content_for :back_link do %><%= link_to "← 求人一覧へ戻る", tenant_jobs_path, class: "tenant-back-link" %><% end %>

<section class="tenant-listing-detail" aria-labelledby="tenant-page-title">
  <div class="tenant-listing-detail__overview">
    <span class="tenant-listing-detail__icon tenant-listing-detail__icon--job" aria-hidden="true">J</span>
    <div class="tenant-listing-detail__identity"><span class="tenant-listing-type tenant-listing-type--job">求人</span><h2><%= @listing.title %></h2></div>
    <div class="tenant-listing-detail__overview-actions"><span class="tenant-listing-status tenant-listing-status--<%= @listing.status %>"><%= @listing.status %></span><%= link_to "編集", edit_tenant_job_path(@listing), class: "tenant-listing-button" %></div>
  </div>
  <section class="tenant-listing-detail__card"><div class="tenant-listing-card-heading"><h3>求人情報</h3><p>掲載内容と募集条件</p></div>
    <dl class="tenant-listing-detail__definition-list">
      <div class="tenant-listing-detail__wide"><dt>説明</dt><dd><%= @listing.description.presence || "-" %></dd></div>
      <div><dt>雇用形態</dt><dd><%= @job_listing.employment_type.presence || "-" %></dd></div><div><dt>職種</dt><dd><%= @job_listing.job_category.presence || "-" %></dd></div>
      <div><dt>勤務エリア</dt><dd><%= @job_listing.work_area.presence || "-" %></dd></div><div><dt>給与種別</dt><dd><%= @job_listing.salary_type.presence || "-" %></dd></div>
    </dl>
  </section>
</section>
