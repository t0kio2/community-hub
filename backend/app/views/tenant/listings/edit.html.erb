<% content_for :title, @listing.listing_type == "stay" ? "宿泊施設編集" : "求人編集" %>
<% content_for :page_title, @listing.listing_type == "stay" ? "宿泊施設を編集" : "求人を編集" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "tenant/listings", "data-turbo-track": "reload" %>
<% end %>
<% content_for :back_link do %>
  <%= link_to "← 掲載詳細へ戻る", tenant_listing_path(@listing), class: "tenant-back-link" %>
<% end %>

<%= render "form", listing: @listing, detail: @detail %>
