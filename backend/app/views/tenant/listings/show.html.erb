<% content_for :title, @listing.title %>
<% content_for :page_title, "掲載詳細" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "tenant/listings", "data-turbo-track": "reload" %>
<% end %>
<% content_for :back_link do %>
  <%= link_to "← 掲載一覧へ戻る", tenant_listings_path, class: "tenant-back-link" %>
<% end %>

<%
  listing_type_labels = { "job" => "求人", "stay" => "宿泊" }
  listing_status_labels = {
    "published" => "公開中",
    "draft" => "下書き",
    "closed" => "公開終了",
    "archived" => "アーカイブ"
  }
%>

<section class="tenant-listing-detail" aria-labelledby="tenant-page-title">
  <div class="tenant-listing-detail__overview">
    <span class="tenant-listing-detail__icon tenant-listing-detail__icon--<%= @listing.listing_type %>" aria-hidden="true">
      <%= @listing.listing_type == "stay" ? "S" : "J" %>
    </span>
    <div class="tenant-listing-detail__identity">
      <span class="tenant-listing-type tenant-listing-type--<%= @listing.listing_type %>"><%= listing_type_labels.fetch(@listing.listing_type, @listing.listing_type) %></span>
      <h2><%= @listing.title %></h2>
    </div>
    <div class="tenant-listing-detail__overview-actions">
      <span class="tenant-listing-status tenant-listing-status--<%= @listing.status %>"><%= listing_status_labels.fetch(@listing.status, @listing.status) %></span>
      <%= link_to "編集", edit_tenant_listing_path(@listing), class: "tenant-listing-button" %>
    </div>
  </div>

  <section class="tenant-listing-detail__card" aria-labelledby="listing-common-heading">
    <div class="tenant-listing-card-heading">
      <h3 id="listing-common-heading">掲載情報</h3>
      <p>公開状態と共通の掲載内容</p>
    </div>
    <dl class="tenant-listing-detail__definition-list">
      <div class="tenant-listing-detail__wide"><dt>説明</dt><dd><%= @listing.description.presence || "-" %></dd></div>
      <div><dt>公開日時</dt><dd><%= @listing.published_at ? l(@listing.published_at, format: :short) : "-" %></dd></div>
      <div><dt>終了日時</dt><dd><%= @listing.closed_at ? l(@listing.closed_at, format: :short) : "-" %></dd></div>
    </dl>
  </section>

  <% if @listing.listing_type == "job" && @detail %>
    <section class="tenant-listing-detail__card" aria-labelledby="job-detail-heading">
      <div class="tenant-listing-card-heading">
        <h3 id="job-detail-heading">求人詳細</h3>
        <p>募集条件と勤務情報</p>
      </div>
      <dl class="tenant-listing-detail__definition-list">
        <div><dt>雇用形態</dt><dd><%= @detail.employment_type.presence || "-" %></dd></div>
        <div><dt>職種</dt><dd><%= @detail.job_category.presence || "-" %></dd></div>
        <div><dt>勤務エリア</dt><dd><%= @detail.work_area.presence || "-" %></dd></div>
        <div><dt>勤務先住所</dt><dd><%= @detail.work_address.presence || "-" %></dd></div>
        <div><dt>給与種別</dt><dd><%= @detail.salary_type.presence || "-" %></dd></div>
        <div><dt>給与</dt><dd><%= [@detail.salary_min, @detail.salary_max].compact.join(" - ").presence || "-" %></dd></div>
        <div><dt>勤務時間</dt><dd><%= @detail.working_hours.presence || "-" %></dd></div>
        <div><dt>勤務日</dt><dd><%= @detail.work_days.presence || "-" %></dd></div>
        <div><dt>応募上限</dt><dd><%= @detail.application_limit.presence || "-" %></dd></div>
      </dl>
    </section>
  <% elsif @detail %>
    <section class="tenant-listing-detail__card" aria-labelledby="stay-detail-heading">
      <div class="tenant-listing-card-heading">
        <h3 id="stay-detail-heading">宿泊詳細</h3>
        <p>施設情報と予約受付期間</p>
      </div>
      <dl class="tenant-listing-detail__definition-list">
        <div><dt>宿泊種別</dt><dd><%= @detail.stay_type.presence || "-" %></dd></div>
        <div><dt>住所</dt><dd><%= @detail.address.presence || "-" %></dd></div>
        <div><dt>定員</dt><dd><%= @detail.capacity.presence || "-" %></dd></div>
        <div><dt>1泊料金</dt><dd><%= @detail.price_per_night.presence || "-" %></dd></div>
        <div><dt>チェックイン</dt><dd><%= @detail.check_in_time&.strftime("%H:%M").presence || "-" %></dd></div>
        <div><dt>チェックアウト</dt><dd><%= @detail.check_out_time&.strftime("%H:%M").presence || "-" %></dd></div>
        <div><dt>予約開始</dt><dd><%= @detail.available_from.presence || "-" %></dd></div>
        <div><dt>予約終了</dt><dd><%= @detail.available_until.presence || "-" %></dd></div>
      </dl>
    </section>
  <% end %>
</section>
