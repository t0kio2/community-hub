<% stay_registration = @listing.listing_type == "stay" %>
<% content_for :title, stay_registration ? "宿泊施設登録" : "求人作成" %>
<% content_for :page_title, stay_registration ? "宿泊施設を登録" : "求人を作成" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "tenant/listings", "data-turbo-track": "reload" %>
<% end %>
<% content_for :back_link do %>
  <%= link_to stay_registration ? "← 宿泊施設へ戻る" : "← 掲載一覧へ戻る", tenant_listings_path, class: "tenant-back-link" %>
<% end %>

<%= render "form", listing: @listing, detail: @detail %>
