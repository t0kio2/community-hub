<% content_for :title, "組織情報編集" %>
<% content_for :page_title, "組織情報を編集" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "tenant/organizations", "data-turbo-track": "reload" %>
<% end %>
<% content_for :back_link do %>
  <%= link_to "← ホームへ戻る", tenant_root_path, class: "tenant-back-link" %>
<% end %>

<section class="tenant-organization-edit" aria-labelledby="tenant-page-title">
  <% if @organization.errors.any? %>
    <div class="tenant-organization-edit__errors" role="alert" aria-labelledby="organization-error-heading">
      <strong id="organization-error-heading">入力内容を確認してください</strong>
      <ul>
        <% @organization.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="tenant-organization-edit__card">
    <div class="tenant-organization-edit__card-heading">
      <div>
        <h2>基本情報</h2>
        <p>テナントの名称と所在地を管理します。</p>
      </div>
      <span class="tenant-organization-edit__status"><%= @organization.status.presence || "状態未設定" %></span>
    </div>

    <%= form_with model: @organization, url: tenant_organization_path, method: :patch, local: true, html: { class: "tenant-organization-edit__form" } do |form| %>
      <div class="tenant-organization-edit__field">
        <label for="tenant_name">組織名 <span>必須</span></label>
        <%= form.text_field :name, required: true, autocomplete: "organization" %>
      </div>

      <div class="tenant-organization-edit__field">
        <%= form.label :kana, "組織名かな" %>
        <%= form.text_field :kana %>
      </div>

      <div class="tenant-organization-edit__field">
        <%= form.label :address, "住所" %>
        <%= form.text_field :address, autocomplete: "street-address" %>
      </div>

      <div class="tenant-organization-edit__actions">
        <%= link_to "キャンセル", tenant_root_path, class: "button" %>
        <%= form.submit "更新する", class: "tenant-organization-edit__submit" %>
      </div>
    <% end %>
  </div>
</section>
