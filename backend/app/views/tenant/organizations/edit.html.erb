<% content_for :title, "組織情報編集" %>
<% content_for :page_title, "組織情報を編集" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "tenant/organizations", "data-turbo-track": "reload" %>
<% end %>
<% content_for :back_link do %>
  <%= link_to "← ホームへ戻る", tenant_root_path, class: "tenant-back-link" %>
<% end %>

<section class="tenant-organization-edit" aria-labelledby="tenant-page-title">
  <% if @tenant.errors.any? %>
    <div class="tenant-organization-edit__errors" role="alert" aria-labelledby="organization-error-heading">
      <strong id="organization-error-heading">入力内容を確認してください</strong>
      <ul>
        <% @tenant.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="tenant-organization-edit__card">
    <div class="tenant-organization-edit__card-heading">
      <div>
        <h2>基本情報</h2>
        <p>テナントの名称を管理します。</p>
      </div>
      <span class="tenant-organization-edit__status"><%= @tenant.status.presence || "状態未設定" %></span>
    </div>

    <%= form_with model: @tenant, url: tenant_organization_path, method: :patch, local: true, html: { class: "tenant-organization-edit__form" } do |form| %>
      <div class="tenant-organization-edit__field">
        <label for="tenant_name">組織名 <span>必須</span></label>
        <%= form.text_field :name, required: true, autocomplete: "organization" %>
      </div>

      <div class="tenant-organization-edit__field">
        <%= form.label :kana, "組織名かな" %>
        <%= form.text_field :kana %>
      </div>

      <div class="tenant-organization-edit__actions">
        <%= form.submit "更新する", class: "tenant-organization-edit__submit" %>
      </div>
    <% end %>
  </div>

  <div class="tenant-organization-edit__card tenant-organization-locations">
    <div class="tenant-organization-edit__card-heading">
      <div>
        <h2>拠点情報</h2>
        <p>組織が利用する住所と地図上の位置を管理します。</p>
      </div>
      <% if @locations.any? %>
        <%= link_to "拠点を追加", new_tenant_location_path, class: "tenant-organization-locations__add" %>
      <% end %>
    </div>

    <% if @locations.any? %>
      <div class="tenant-organization-locations__list">
        <% @locations.each do |location| %>
          <article class="tenant-organization-location">
            <div class="tenant-organization-location__icon" aria-hidden="true">⌖</div>
            <div class="tenant-organization-location__content">
              <div class="tenant-organization-location__heading">
                <strong><%= location.name %></strong>
                <% if @tenant.primary_tenant_location_id == location.id %>
                  <span>代表拠点</span>
                <% end %>
              </div>
              <p><%= location.full_address.presence || "住所未設定" %></p>
              <small>緯度 <%= location.latitude.to_s("F") %> / 経度 <%= location.longitude.to_s("F") %></small>
            </div>
            <%= link_to "編集", edit_tenant_location_path(location), class: "tenant-organization-location__edit" %>
          </article>
        <% end %>
      </div>
      <div class="tenant-organization-locations__footer">
        <%= link_to "すべての拠点を管理", tenant_locations_path %>
      </div>
    <% else %>
      <div class="tenant-organization-locations__empty">
        <span aria-hidden="true">⌖</span>
        <strong>拠点が登録されていません</strong>
        <p>住所と緯度・経度を登録すると、代表拠点やListingの所在地として利用できます。</p>
        <%= link_to "拠点を登録", new_tenant_location_path, class: "tenant-organization-locations__register" %>
      </div>
    <% end %>
  </div>
</section>
