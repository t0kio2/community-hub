<% content_for :title, "テナント" %>
<% content_for :page_title, "テナント管理" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "admin/tenants", "data-turbo-track": "reload" %>
<% end %>

<%
  status_labels = {
    "active" => "有効",
    "reviewing" => "確認待ち",
    "suspended" => "利用停止"
  }
%>

<section class="tenant-index" aria-labelledby="admin-page-title">
  <div class="tenant-index__filters" aria-label="テナントの絞り込み">
    <label class="visually-hidden" for="tenant-query">組織名またはメールアドレス</label>
    <input id="tenant-query" type="search" placeholder="組織名またはメールアドレスで検索" disabled>

    <label class="visually-hidden" for="tenant-status">テナントの状態</label>
    <select id="tenant-status" disabled>
      <option>すべての状態</option>
      <option>有効</option>
      <option>確認待ち</option>
      <option>利用停止</option>
    </select>

    <span class="tenant-index__filter-note">検索・絞り込みは準備中</span>
  </div>
  <div class="tenant-index__toolbar">
    <button class="button button-primary" type="button" disabled>＋ テナントを作成</button>
  </div>

  <div class="tenant-index__table-card">
    <table class="tenant-index__table">
      <thead>
        <tr>
          <th scope="col">組織</th>
          <th scope="col">ownerアカウント</th>
          <th scope="col">掲載</th>
          <th scope="col">状態</th>
          <th scope="col">登録日</th>
          <th scope="col"><span class="visually-hidden">操作</span></th>
        </tr>
      </thead>
      <tbody>
        <% @tenants.each do |tenant| %>
          <% owner_member = tenant.tenant_members.find { |member| member.role == "owner" } %>
          <% owner_account = owner_member&.account %>
          <tr>
            <td>
              <div class="tenant-identity">
                <span class="tenant-identity__logo" aria-hidden="true"><%= tenant.name.first %></span>
                <span class="tenant-identity__copy">
                  <strong><%= tenant.name %></strong>
                  <small><%= tenant.address.presence || "所在地未設定" %></small>
                </span>
              </div>
            </td>
            <td>
              <span class="tenant-owner-email"><%= owner_account&.email || "owner未設定" %></span>
            </td>
            <td><strong class="tenant-listing-count"><%= tenant.listings.size %></strong>件</td>
            <td>
              <span class="status-badge status-badge--<%= tenant.status %>">
                <%= status_labels.fetch(tenant.status, tenant.status) %>
              </span>
            </td>
            <td><%= l(tenant.created_at, format: :long) %></td>
            <td class="tenant-index__actions">
              <%= link_to "詳細", admin_tenant_path(tenant), class: "button button-small" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @tenants.empty? %>
      <div class="tenant-index__empty">
        <strong>テナントがありません</strong>
        <p>登録されたテナントはここに表示されます。</p>
      </div>
    <% end %>
  </div>
</section>
