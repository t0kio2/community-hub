<% content_for :title, "Edit Tenant Account" %>

<div class="form-box">
  <div class="nav">
    <a href="<%= admin_tenant_accounts_path %>">← テナント一覧へ戻る</a>
  </div>
  <h1>テナントアカウント編集</h1>

  <% if @tenant.errors.any? %>
    <div class="errors">
      <p>エラーが発生しました:</p>
      <ul>
        <% @tenant.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @tenant, url: admin_tenant_account_path(@tenant), method: :patch, local: true do |form| %>
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <label for="tenant_email">Email</label>
    <%= form.email_field :email, id: "tenant_email", required: true, autocomplete: "username" %>

    <p class="hint">パスワード未入力の場合は変更されません。</p>

    <label for="tenant_password">Password</label>
    <%= form.password_field :password, id: "tenant_password", autocomplete: "new-password" %>

    <label for="tenant_password_confirmation">Password confirmation</label>
    <%= form.password_field :password_confirmation, id: "tenant_password_confirmation", autocomplete: "new-password" %>

    <button type="submit">更新する</button>
  <% end %>
</div>

<style>
  .form-box { max-width: 520px; padding: 24px; border: 1px solid #ddd; border-radius: 8px; }
  label { display: block; margin: 10px 0 6px; }
  input[type="email"], input[type="password"] { width: 100%; padding: 10px; box-sizing: border-box; }
  form button { margin-top: 16px; padding: 10px 16px; }
  .errors { background: #fff3f3; color: #900; padding: 10px; margin-bottom: 12px; border: 1px solid #f5c2c2; border-radius: 6px; }
  .nav { margin-bottom: 16px; }
  .nav a { color: #0366d6; text-decoration: none; }
  .hint { margin-top: 10px; color: #555; }
</style>
