<% content_for :title, "テナント" %>
<% content_for :page_title, "テナント管理" %>
<div class="toolbar">
  <a class="button" href="<%= new_admin_tenant_account_path %>">＋ 新規作成</a>
</div>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Email</th>
      <th>作成日</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @tenants.each do |tenant| %>
      <tr>
        <td><%= tenant.id %></td>
        <td><%= tenant.email %></td>
        <td><%= l(tenant.created_at, format: :long) rescue tenant.created_at %></td>
        <td>
          <a class="button" href="<%= admin_tenant_account_path(tenant) %>">掲載</a>
          <a class="button" href="<%= edit_admin_tenant_account_path(tenant) %>">編集</a>
          <% if policy(tenant, with: Admin::TenantAccountPolicy).destroy? %>
            <%= form_with url: admin_tenant_account_path(tenant), method: :delete, local: true, html: { class: "inline-form", onsubmit: "return confirm('削除してよろしいですか？');" } do %>
              <button type="submit">削除</button>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<style>
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .toolbar h1 { margin: 0; }
  table { width: 100%; border-collapse: collapse; margin-top: 16px; }
  th, td { border: 1px solid #ddd; padding: 8px 10px; }
  th { background: #f9f9f9; text-align: left; }
  .inline-form { display: inline-block; margin-left: 6px; }
</style>
