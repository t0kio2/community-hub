<% content_for :title, "テナント作成" %>
<% content_for :page_title, "テナント作成" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "admin/tenant_accounts", "data-turbo-track": "reload" %>
<% end %>
<% content_for :back_link do %>
  <%= link_to "← テナントアカウント一覧へ戻る", admin_tenant_accounts_path, class: "admin-back-link" %>
<% end %>

<section class="tenant-account-create" aria-labelledby="admin-page-title">
  <% if @tenant.errors.any? || @organization&.errors&.any? %>
    <div class="tenant-account-create__errors" role="alert" aria-labelledby="tenant-account-error-heading">
      <strong id="tenant-account-error-heading">入力内容を確認してください</strong>
      <ul>
        <% @tenant.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
        <% @organization&.errors&.full_messages&.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @tenant, url: admin_tenant_accounts_path, method: :post, local: true, html: { class: "tenant-account-create__form" } do |form| %>
    <div class="tenant-account-create__form-grid">
      <fieldset class="tenant-account-create__card">
        <legend class="visually-hidden">アカウント情報</legend>
        <div class="tenant-account-create__card-heading">
          <h2>アカウント情報</h2>
          <p>テナントへログインするownerアカウントを設定します。</p>
        </div>

        <div class="field">
          <label for="tenant_email">メールアドレス <span class="tenant-account-create__required">必須</span></label>
          <%= form.email_field :email, id: "tenant_email", required: true, autocomplete: "username", placeholder: "owner@example.com" %>
        </div>

        <div class="field">
          <label for="tenant_password">パスワード <span class="tenant-account-create__required">必須</span></label>
          <div class="tenant-account-create__password-field">
            <%= form.password_field :password, id: "tenant_password", required: true, autocomplete: "new-password" %>
            <button type="button" class="tenant-account-create__visibility-button" data-target="tenant_password" aria-pressed="false" aria-label="パスワードを表示">表示</button>
          </div>
        </div>

        <div class="field">
          <label for="tenant_password_confirmation">パスワード確認 <span class="tenant-account-create__required">必須</span></label>
          <div class="tenant-account-create__password-field">
            <%= form.password_field :password_confirmation, id: "tenant_password_confirmation", required: true, autocomplete: "new-password" %>
            <button type="button" class="tenant-account-create__visibility-button" data-target="tenant_password_confirmation" aria-pressed="false" aria-label="パスワード確認を表示">表示</button>
          </div>
        </div>

        <div class="tenant-account-create__role" aria-label="初期ロール">
          <span>初期ロール</span>
          <strong>owner</strong>
          <p>テナントの管理責任者として作成されます。この画面では変更できません。</p>
        </div>
      </fieldset>

      <fieldset class="tenant-account-create__card">
        <legend class="visually-hidden">組織情報</legend>
        <div class="tenant-account-create__card-heading">
          <h2>組織情報</h2>
          <p>管理対象となるテナントの基本情報を登録します。</p>
        </div>

        <div class="field">
          <label for="organization_name">組織名 <span class="tenant-account-create__required">必須</span></label>
          <%= text_field_tag "tenant[name]", params.dig(:tenant, :name), id: "organization_name", required: true, autocomplete: "organization", placeholder: "株式会社コミュニティハブ" %>
        </div>

        <div class="field">
          <label for="organization_kana">組織名カナ</label>
          <%= text_field_tag "tenant[kana]", params.dig(:tenant, :kana), id: "organization_kana", placeholder: "カブシキガイシャコミュニティハブ" %>
        </div>

        <div class="field">
          <label for="organization_address">所在地</label>
          <%= text_field_tag "tenant[address]", params.dig(:tenant, :address), id: "organization_address", autocomplete: "street-address", placeholder: "東京都〇〇区〇〇 1-2-3" %>
        </div>

        <div class="tenant-account-create__status-note">
          <span aria-hidden="true"></span>
          作成後のテナント状態は「有効」に設定されます。
        </div>
      </fieldset>
    </div>

    <div class="tenant-account-create__actions">
      <%= link_to "キャンセル", admin_tenant_accounts_path, class: "button" %>
      <button type="submit" class="tenant-account-create__submit">テナントを作成</button>
    </div>
  <% end %>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".tenant-account-create__visibility-button").forEach(function (button) {
      button.addEventListener("click", function () {
        var input = document.getElementById(button.getAttribute("data-target"));
        if (!input) return;

        var isHidden = input.type === "password";
        input.type = isHidden ? "text" : "password";
        button.textContent = isHidden ? "非表示" : "表示";
        button.setAttribute("aria-pressed", String(isHidden));
      });
    });
  });
</script>
